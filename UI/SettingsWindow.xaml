<Window x:Class="NomisKitchenHDT.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NomisKitchenHDT.UI"
        Title="Nomi's Kitchen" Height="640" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Nomi's Kitchen"
                   Foreground="#F5A623" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <CheckBox x:Name="DisableAbbreviationCheck"
                      Content="Disable abbreviation (needs Hearthstone restart)"
                      Foreground="White" Margin="0,4"/>
            <CheckBox x:Name="ShowApmCheck" Content="Show APM overlay"
                      Foreground="White" Margin="0,4"/>
            <CheckBox x:Name="LockOverlayCheck" Content="Lock overlay (clicks pass through to game)"
                      Foreground="White" Margin="0,4"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Overlay style"
                   Foreground="#B8B8B8" FontWeight="Bold" Margin="0,8,0,6"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="45"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Font" Foreground="White" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="FontCombo" Margin="0,4"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Label size" Foreground="White" VerticalAlignment="Center" Margin="0,4"/>
            <Slider    Grid.Row="1" Grid.Column="1" x:Name="LabelSizeSlider" Minimum="6" Maximum="48" TickFrequency="1"
                       IsSnapToTickEnabled="True" Margin="0,4" ValueChanged="OnLiveChange"/>
            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="LabelSizeValue" Text="11" Foreground="#B8B8B8"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,4,0,4"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Value size" Foreground="White" VerticalAlignment="Center" Margin="0,4"/>
            <Slider    Grid.Row="2" Grid.Column="1" x:Name="ValueSizeSlider" Minimum="8" Maximum="72" TickFrequency="1"
                       IsSnapToTickEnabled="True" Margin="0,4" ValueChanged="OnLiveChange"/>
            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="ValueSizeValue" Text="22" Foreground="#B8B8B8"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,4,0,4"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Overlay scale" Foreground="White" VerticalAlignment="Center" Margin="0,4"/>
            <Slider    Grid.Row="3" Grid.Column="1" x:Name="ScaleSlider" Minimum="0.5" Maximum="2.5" TickFrequency="0.05"
                       IsSnapToTickEnabled="True" Margin="0,4" ValueChanged="OnLiveChange"/>
            <TextBlock Grid.Row="3" Grid.Column="2" x:Name="ScaleValue" Text="1.00" Foreground="#B8B8B8"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,4,0,4"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Decimal places" Foreground="White" VerticalAlignment="Center" Margin="0,4"/>
            <Slider    Grid.Row="4" Grid.Column="1" x:Name="DecimalSlider" Minimum="0" Maximum="3" TickFrequency="1"
                       IsSnapToTickEnabled="True" Margin="0,4" ValueChanged="OnLiveChange"/>
            <TextBlock Grid.Row="4" Grid.Column="2" x:Name="DecimalValue" Text="1" Foreground="#B8B8B8"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,4,0,4"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Background" Foreground="White" VerticalAlignment="Center" Margin="0,4"/>
            <local:ColorField Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" x:Name="BackgroundField" Margin="0,4"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Border" Foreground="White" VerticalAlignment="Center" Margin="0,4"/>
            <local:ColorField Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" x:Name="BorderField" Margin="0,4"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Label color" Foreground="White" VerticalAlignment="Center" Margin="0,4"/>
            <local:ColorField Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" x:Name="LabelColorField" Margin="0,4"/>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Value color" Foreground="White" VerticalAlignment="Center" Margin="0,4"/>
            <local:ColorField Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ValueColorField" Margin="0,4"/>
        </Grid>

        <StackPanel Grid.Row="4" VerticalAlignment="Bottom">
            <CheckBox x:Name="AutoUpdateCheck" Content="Check for updates on launch"
                      Foreground="White" Margin="0,12,0,4"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CheckUpdateButton" Content="Check for updates" Width="140" Click="OnCheckUpdate"/>
                <Button x:Name="UpdateButton" Content="Download update" Width="140" Margin="8,0,0,0"
                        Click="OnDownloadUpdate" Visibility="Collapsed"/>
                <TextBlock x:Name="UpdateStatusText" Foreground="#B8B8B8" FontSize="12"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Foreground="#B8B8B8" FontSize="12"
                       TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Reset defaults" Width="120" Margin="0,0,8,0" Click="OnReset"/>
            <Button Content="Close" Width="80" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
