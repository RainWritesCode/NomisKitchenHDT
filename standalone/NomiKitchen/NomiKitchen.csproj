<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NomiKitchenStandalone</AssemblyName>
    <RootNamespace>NomiKitchen</RootNamespace>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- The BepInEx mods are embedded so the single exe can install them without the repo. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\Resources\com.community.hs.NomiCantDance.dll" LogicalName="com.community.hs.NomiCantDance.dll" />
    <EmbeddedResource Include="..\..\Resources\com.community.hs.NomiHatesAbbreviation.dll" LogicalName="com.community.hs.NomiHatesAbbreviation.dll" />
    <EmbeddedResource Include="..\..\Resources\com.community.hs.NomisKitchenApm.dll" LogicalName="com.community.hs.NomisKitchenApm.dll" />
  </ItemGroup>

</Project>
